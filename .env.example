# Live-test settings. Copy to `.env` (gitignored) and fill in:
#
#   cp .env.example .env && chmod 600 .env
#
# The live-test harness reads this file for any variable not already set in
# the environment (the environment wins). Only the live tests read it; the
# server itself uses the environment or ~/.gitlab_mcp.json.

GITLAB_URL=https://gitlab.com
# Personal access token with `api` scope and write access to the test project.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Optional; defaults to 3kirt1/gitlab-mcp-testing.
# GITLAB_TEST_PROJECT=3kirt1/gitlab-mcp-testing
